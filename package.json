{
  "name": "sweettreats",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "lucide-react": "^1.21.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.1",
      "@libsql/client": "0.15.15",
      "libsql": "0.5.22",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.91.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev",
    "dev:cf": "bun --filter web cf:dev",
    "test": "vp run -r test",
    "test:e2e": "bun --filter web e2e",
    "db:generate": "vp run --filter @sweettreats/db db:generate",
    "deploy": "vp run --filter @sweettreats/infra deploy",
    "destroy": "vp run --filter @sweettreats/infra destroy"
  },
  "dependencies": {
    "@sweettreats/env": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@sweettreats/config": "workspace:*",
    "@types/node": "^22.20.0",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.72.0",
    "rolldown": "1.1.0",
    "typescript": "^6.0.3",
    "vite-plus": "0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "bun@1.3.14"
}
