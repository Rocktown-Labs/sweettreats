{
  // Local development config for `wrangler dev` only.
  // Production deploys go through Alchemy (packages/infra/alchemy.run.ts) —
  // never deploy with `wrangler deploy`.
  // Secrets (BETTER_AUTH_SECRET, etc.) live in apps/web/.dev.vars, which is
  // gitignored, never in this committed file.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sweettreats",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ADMIN_EMAILS": "lauryan0311@gmail.com,admin@sweettreatslr.com,cg@rocktownlabs.com",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sweettreats-db",
      "migrations_dir": "../../packages/db/src/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sweettreats-media",
    },
  ],
}
