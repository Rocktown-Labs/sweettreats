{
  // Local development config for `wrangler dev` only.
  // Production deploys go through Alchemy (packages/infra/alchemy.run.ts) —
  // never deploy with `wrangler deploy`.
  // Secrets (BETTER_AUTH_SECRET, etc.) live in apps/web/.dev.vars, which is
  // gitignored, never in this committed file.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sweettreats",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ADMIN_EMAILS": "lauryan0311@gmail.com,admin@sweettreatslr.com",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  // wrangler's esbuild bundles ./worker.ts without the TanStack Start vite
  // plugin, so the plugin-resolved virtuals inside @tanstack/start-server-core
  // cannot resolve on their own. They are dead code at runtime (fetch is
  // served by the pre-built dist bundle), so a shared stub module satisfies
  // the bundler. See workers/tanstack-stubs.js for the full explanation.
  "alias": {
    "#tanstack-router-entry": "./workers/tanstack-stubs.js",
    "#tanstack-start-entry": "./workers/tanstack-stubs.js",
    "tanstack-start-manifest:v": "./workers/tanstack-stubs.js",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sweettreats-db",
      "migrations_dir": "../../packages/db/src/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sweettreats-media",
    },
  ],
  // Realtime admin badge fan-out. Alchemy manages the same class in prod
  // (see packages/infra/alchemy.run.ts); this is the local-dev twin.
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATIONS",
        "class_name": "NotificationCenter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NotificationCenter"],
    },
  ],
}
